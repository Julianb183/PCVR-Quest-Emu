<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101820"
    android:contentDescription="Windows ARM64 virtual machine controls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PCVR QUEST EMU"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Windows ARM64 virtual machine"
            android:textColor="#B9E6FF"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Accessible controls. Move through the controls with the Quest controller, keyboard, or screen reader."
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="VIRTUAL MACHINE SETTINGS"
            android:textColor="#6DD5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/memoryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Guest memory, in megabytes. Choose between 1024 and 4096."
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/memoryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#6DD5FF"
            android:hint="For example, 4096"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="58dp"
            android:text="4096"
            android:textColor="#FFFFFF"
            android:textColorHint="#B9C7D0"
            android:contentDescription="Guest memory in megabytes" />

        <Button
            android:id="@+id/selectImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="SELECT WINDOWS ARM64 IMAGE"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:contentDescription="Select a legally obtained Windows ARM64 disk image" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="TOOLS"
            android:textColor="#6DD5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <Button
            android:id="@+id/openBlender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="64dp"
            android:text="OPEN BLENDER FILE"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:contentDescription="Choose a Blender blend file to copy into the app" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="VM CONTROLS"
            android:textColor="#6DD5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <Button
            android:id="@+id/startWindows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="72dp"
            android:text="START VIRTUAL MACHINE"
            android:textAllCaps="false"
            android:textSize="19sp"
            android:contentDescription="Start the Windows ARM64 virtual machine" />

        <Button
            android:id="@+id/stopWindows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="72dp"
            android:text="STOP VIRTUAL MACHINE"
            android:textAllCaps="false"
            android:textSize="19sp"
            android:contentDescription="Stop the virtual machine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="STATUS"
            android:textColor="#6DD5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/emulatorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="No Windows image selected"
            android:textColor="#101820"
            android:textIsSelectable="true"
            android:textSize="17sp"
            android:typeface="monospace"
            android:contentDescription="Virtual machine status" />
    </LinearLayout>
</ScrollView>
