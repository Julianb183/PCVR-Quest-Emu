<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#05070A">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="QUEST TERMINAL  •  local sandbox" android:textColor="#00E5FF"
        android:textSize="18sp" android:typeface="monospace" android:paddingBottom="12dp" />
    <ScrollView android:id="@+id/outputScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#0B1117" android:padding="16dp">
        <TextView android:id="@+id/output" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#D8F3DC" android:textSize="16sp" android:typeface="monospace" android:textIsSelectable="true" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp">
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="type a command" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#78909C"
            android:inputType="text" android:fontFamily="monospace" />
        <Button android:id="@+id/run" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RUN" />
    </LinearLayout>
</LinearLayout>
